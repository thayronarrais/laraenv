# Build artifacts
build/bin/
build/windows/installer/tmp/
build/windows/installer/.build-*.log
build/windows/pgvector/dist/
*.exe
*.msi
*.wixpdb

# Tooling scratch
.superpowers/
/debug.log

# Wails generated bindings (regenerated on each build)
frontend/wailsjs/

# Frontend
node_modules/
frontend/dist/
frontend/.vite/
.vite/

# Go
*.test
*.out
vendor/

# IDE / OS
.DS_Store
.vscode/
.idea/
*.swp
Thumbs.db

# Local config / secrets — never commit
*.local.json
.env
.env.*
build/cache/
build/archive/
build/logs/
build/verification/
tools/screenshots/debug.log

# Release artifacts (regenerated by build-release.ps1)
build/release/
build/source/

# Source snapshot integrity metadata is regenerated on export.
/SOURCE_SNAPSHOT_MANIFEST.json

# Claude Code worktrees (full checkouts, never commit)
.claude/worktrees/
.claude/settings.json
.claude/scheduled_tasks.lock

# Monaco AMD bundle, copied out of node_modules by
# frontend/scripts/vendor-monaco.mjs on every dev/build/test run
frontend/public/vs/

# Legal assets are copied from reviewed source notices before dev/build/test.
frontend/public/legal/

# Rebuild the deployment TUI from source; do not publish stale local binaries.
/deploy-tui-linux-amd64
